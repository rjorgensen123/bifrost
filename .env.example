# Copy to .env and adjust. Used by docker-compose.
# PROTECT THE FILE: chmod 600 .env — it holds DB_PASSWORD/SECRET_KEY/ADMIN_PASSWORD and must
# never be readable by other local users.
DB_PASSWORD=change-me-please

# Database robustness: connect_timeout (seconds) so a database that does not answer does not hang the
# connection, and statement_timeout (ms) so a hanging query is cancelled (a clean "database down"
# instead of a blocked worker).
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=30000


# Host port the app is published on. The container always listens on 8123 internally;
# this only sets which port on the host is mapped to it.
PORT=8123

# Number of reverse-proxy hops in front of the app whose X-Forwarded-* headers are trusted.
# 1 = one nginx (default). 0 = off (app exposed directly). 2+ = several hops (e.g. CDN → nginx).
PROXY_COUNT=1
# Networks (comma-separated CIDR) the DIRECT sender must be in for X-Forwarded-For to be trusted.
# Empty = private networks + loopback (nginx in Docker).
#TRUSTED_PROXIES=

# The Secure flag on the session cookie is set AUTOMATICALLY when the app is reached over HTTPS (via
# nginx's X-Forwarded-Proto), and not over plain HTTP — no setting needed. 1 = always force it on.
COOKIE_SECURE=0

# Maximum request size in MB (uploads: logo, theme CSS, background image).
# Stops a huge file from being decoded in memory and taking down the web app worker. Default 20.
MAX_UPLOAD_MB=20

# How long the event log (the Log page, «Logg») is kept, in days.
# Cleaned up daily by the web app worker. Default 180. 0 = never clean up (grows without limit).
LOG_RETENTION_DAYS=180


# Flask session signing key. Set a long, random value in production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Empty => a random key is generated at first start and stored in the database (shared by all
# workers, survives restarts). If it is set here, this one is used instead.
SECRET_KEY=

# Admin password at the very first start. If you change nothing, 'change-me-soon' is used
# (change it AT ONCE under Admin → Security («Sikkerhet»), or with
# `docker compose exec webapp python manage.py set-admin-password`). The first login
# forces a change anyway while the built-in default password is in use.
ADMIN_PASSWORD=change-me-soon

# Automatic logout for admin sessions. 0 turns off that check.
#   ADMIN_IDLE_MIN  – log out an admin after this many minutes without activity
#   ADMIN_MAX_HOURS – absolute maximum lifetime of an admin session from login
ADMIN_IDLE_MIN=0
ADMIN_MAX_HOURS=18
# Absolute maximum lifetime (days) for ordinary users from login. 0 = off.
# Admin has its own timeout above; this applies only to logged-in ordinary users.
USER_MAX_DAYS=7
# Absolute maximum lifetime (days) for operator sessions. 0 = off.
#OPERATOR_MAX_DAYS=2
# Show the UI for custom groups (built, but hidden by default). 1 = on.
#BIFROST_CUSTOM_GROUPS=0

# "Us" in the network — shown, among other places, as the hub of the Distribution map («Fordeling»).
# OUR_NAME/OUR_ASN are a fallback for a fresh deploy; they CAN be changed in the web interface under
# Admin → Settings («Innstillinger») (the database overrides .env).
OUR_NAME=Network
OUR_ASN=AS65432
# Logo and colour theme are set under Admin → Settings (uploaded and stored in-house in the
# database). The old BRAND_LOGO/BRAND_CSS (external file/URL) have been removed for security
# reasons — if they are set here, they are ignored.

# Geographic background map: default map source for «Bakgrunnskart…» (background map) in the map
# editor. Built in: kartverket (Norway, greyscale — default), kartverket_farge (Norway, colour),
# kartverket_toporaster (Norway, topo raster), kartverket_sjokart (Norway, nautical chart),
# opentopomap (global, topographic), carto (global, muted) and carto_voyager (colour) — both live
# ONLY and need CARTO_API_KEY — osm (live ONLY), custom.
MAP_SOURCE=kartverket
# Your own XYZ tile URL ({z}/{x}/{y}) if MAP_SOURCE=custom (self-hosted tiles or similar):
MAP_SOURCE_URL=
MAP_SOURCE_ATTRIBUTION=
# Google as a LIVE background (Maps Tiles API). Google can only be chosen when this is set.
# NB: a tile key is exposed to the browser — restrict it by HTTP referrer in the Google Cloud
# console. Google can only be used live (not as a snapshot — licence terms).
GOOGLE_MAPS_API_KEY=
# CARTO API key (https://carto.com/basemaps/apikey/). CARTO can only be chosen when this is set, and
# only live — CARTO's terms require a key and forbid storing the tiles on a server. The key is exposed
# to the browser with the tiles — restrict it in the CARTO dashboard. Can also be set under
# Admin → Settings.
CARTO_API_KEY=
# Draft maps (parked/abandoned) are removed after this many days without activity.
# Archived maps never expire. 0 = off.
DRAFT_EXPIRE_DAYS=28
# Temporary working copies are normally discarded when you leave the editor; this backstop
# removes working copies left behind by sessions that ended abruptly (minutes). 0 = off.
SCRATCH_EXPIRE_MIN=60

# Demo without real devices: 1 = built-in Norwegian backbone data set + synthetic counters.
# Load it via Admin → «Last inn demo-data» (load demo data) or `manage.py seed-demo`.
DEMO_MODE=0

# Periodic re-scan: syncs ifAlias/name/speed for all interfaces over SNMP.
# RESCAN_INTERVAL = seconds between runs (default 24 h — once a day is enough).
# RESCAN_HOURS = the hours it may run in, in the app's time zone, e.g. "2-6" = only 02:00–05:59
# (a night window across midnight: "22-5"). Empty = any time. Set a night window to avoid
# SNMP load in the middle of the day.
RESCAN_INTERVAL=86400
RESCAN_HOURS=

# Logical map (OSPF): how often (seconds) the self-building logical OSPF map is rebuilt
# automatically by the web app worker. Default 24 h (once a day is enough — OSPF metrics rarely change).
# 0 = turn off automatic builds (then build only by hand via «Bygg kartet nå» or manage.py ospf-build).
OSPF_REBUILD_INTERVAL=86400
# MOCK_OSPF=1 gives a synthetic OSPF topology (like DEMO_MODE) — for test/demo without real SNMP gear.
MOCK_OSPF=0
# Default SNMP v1/v2c community used when a host has none of its own (among others for OSPF mapping).
# Can also be set/overridden under Admin → Settings (the database wins over this). Default "public".
SNMP_COMMUNITY=public

# --- Fine-tuning variables (rarely changed; the defaults are sensible) ---
# Minimum password length when changing a password.
MIN_PASSWORD_LEN=12
# Seconds between automatic builds of MPLS LSPs (0 = off; then build by hand). Default 24 h.
LSP_REBUILD_INTERVAL=86400
# Poller SNMP timeout (seconds) and number of retries per host.
SNMP_TIMEOUT=3
SNMP_RETRIES=1
# Poller: time budget (seconds) per host per cycle, maximum OIDs per SNMP request, and maximum hosts
# polled at the same time.
#POLL_HOST_TIMEOUT=60
#SNMP_MAX_OIDS_PER_GET=60
#POLL_CONCURRENCY=64
# «Oppdag host» (discover host): time budget (seconds) for the whole SNMP discovery.
#DISCOVER_TIMEOUT=100
# NetBox sync: total time budget (seconds) for one sync run.
#NETBOX_SYNC_BUDGET=90
